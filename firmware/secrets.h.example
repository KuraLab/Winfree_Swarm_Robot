// secrets.h.example
// これを各スケッチフォルダ（Winfree_leader/ と Winfree_follower/）に
// secrets.h としてコピーし、実際の値に書き換える。secrets.h は .gitignore 済み。
//
// ロボットは上から順に接続を試み（各5秒）、最初に繋がったものを使う。
#pragma once

const char* WIFI_CANDIDATES[][4] = {
    { "YOUR_SSID_1", "YOUR_PASSWORD_1" },
    { "YOUR_SSID_2", "YOUR_PASSWORD_2" },
};

// leader のみ使用（ArduinoOTA.setPassword）。
// follower はコード上OTAパスワード無しなので未使用だが、同じファイルを置いて構わない。
#define OTA_PASSWORD  "CHANGE_ME"
